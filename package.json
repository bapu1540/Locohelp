{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": ">=1.0.0",
    "@tailwindcss/vite": ">=4.0.0",
    "@vis.gl/react-google-maps": ">=1.0.0",
    "@vitejs/plugin-react": ">=4.3.0",
    "bcryptjs": ">=2.4.3",
    "dotenv": ">=16.4.0",
    "esbuild": ">=0.24.0",
    "express": "^4.21.2",
    "firebase": ">=11.0.0",
    "lucide-react": ">=0.460.0",
    "motion": ">=11.11.0",
    "nodemailer": ">=6.9.0",
    "pg": ">=8.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": ">=4.19.0",
    "vite": ">=6.0.0"
  },
  "optionalDependencies": {
    "firebase-admin": ">=12.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": ">=2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": ">=20.0.0",
    "@types/nodemailer": ">=6.4.0",
    "@types/pg": ">=8.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "tailwindcss": ">=4.0.0",
