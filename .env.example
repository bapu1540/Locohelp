# Railway PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

# Optional: Email SMTP Configuration (for OTP verification emails)
# SMTP_USER=
# SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Optional: Gemini API Key (Uses system key by default)
# GEMINI_API_KEY=
