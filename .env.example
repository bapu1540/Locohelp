# Railway PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

# Brevo (Sendinblue) Transactional Email API for OTP
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=chauhansanjay932@gmail.com
BREVO_SENDER_NAME="LocoHelp Verification"

# Session Security (JWT / Cookie persistence)
JWT_SECRET=locohelp-secure-production-secret-2026
PASSWORD_SALT=locohelp_salt_2026

# Admin Authorization & CORS Protection (Railway Production)
ADMIN_EMAIL=chauhansanjay932@gmail.com
ADMIN_PASSWORD=your_secure_admin_password_here
ALLOWED_ORIGINS=https://your-railway-domain.up.railway.app

# Optional: SMTP Fallback (if Brevo key not provided)
# SMTP_USER=
# SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Optional: Gemini API Key (Uses system key by default)
# GEMINI_API_KEY=

# Firebase Storage Configuration (Media Uploads inside locohelp/ folder)
